# dc_agent 运行配置示例（请勿提交包含真实密钥的 .env 文件）
# 默认 llm_provider=scripted，无需模型 API Key 即可启动全功能离线确定性引擎

LLM_PROVIDER=scripted
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# LLM_API_KEY=your_api_key_here
LLM_TIMEOUT=120

# 可选：指定真实 SAC 语料所在目录（默认自动探测同级 ../sql_explorer）
# SQL_EXPLORER_DIR=/path/to/sql_explorer

# 可选：自定义数据库连接与 Blob 存储目录
# DATABASE_URL=sqlite:///./backend/var/dc_agent.db
# BLOB_DIR=./backend/var/blobs
